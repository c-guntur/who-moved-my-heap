<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>conf.session</groupId>
    <artifactId>who-moved-my-heap</artifactId>
    <version>1.0-SNAPSHOT</version>

    <name>Who Moved My Heap</name>
    <url>https://github.com/c-guntur/who-moved-my-heap</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <eclipse-collections.version>13.0.0</eclipse-collections.version>
        <jmh.version>1.37</jmh.version>
        <jol.version>0.17</jol.version>

        <playwright.version>1.56.0</playwright.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <asciidoctor-maven-plugin.version>3.2.0</asciidoctor-maven-plugin.version>
        <asciidoctorj-revealjs.version>5.2.0</asciidoctorj-revealjs.version>
        <revealjs.version>4.1.3</revealjs.version>
        <asciidoctorj-diagram.version>3.2.1</asciidoctorj-diagram.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- Libraries used -->
        <dependency>
            <groupId>org.openjdk.jol</groupId>
            <artifactId>jol-core</artifactId>
            <version>${jol.version}</version>
        </dependency>

        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections</artifactId>
            <version>${eclipse-collections.version}</version>
        </dependency>

        <!-- Drives headless Chrome for the PDFs; only on the classpath with -Pslides -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- Joins the deck PDFs into one PDF of the whole talk (SlidesToPdf) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!--HTML: plain pages (html5) and reveal.js decks -->
        <dependency>
            <groupId>org.asciidoctor</groupId>
            <artifactId>asciidoctorj-revealjs</artifactId>
            <version>${asciidoctorj-revealjs.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
<!--            <scope>test</scope>-->
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
<!--            <scope>test</scope>-->
        </dependency>

        <!-- Benchmarking -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- clean lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#clean_Lifecycle -->
                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                    <configuration>
                        <!-- mvn clean removes both build folders: target and target-bench (bench profile) -->
                        <filesets>
                            <fileset>
                                <directory>${project.basedir}/target</directory>
                            </fileset>
                            <fileset>
                                <directory>${project.basedir}/target-bench</directory>
                            </fileset>
                        </filesets>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <source>25</source>
                        <target>25</target>
                        <!-- SlidesToPdf needs Playwright, which is only on the classpath with -Pslides; that profile runs it from source -->
                        <excludes>
                            <exclude>tools/presentation/SlidesToPdf.java</exclude>
                        </excludes>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.openjdk.jmh</groupId>
                                <artifactId>jmh-generator-annprocess</artifactId>
                                <version>${jmh.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.2</version>
                    <configuration>
                        <filters>
                            <filter>
                                <artifact>*:*</artifact>
                                <excludes>
                                    <exclude>META-INF/*.SF</exclude>
                                    <exclude>META-INF/*.DSA</exclude>
                                    <exclude>META-INF/*.RSA</exclude>
                                </excludes>
                            </filter>
                        </filters>
                        <finalName>microbenchmarks</finalName>
                        <transformers>
                            <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                <mainClass>org.openjdk.jmh.Main</mainClass>
                            </transformer>
                        </transformers>
                    </configuration>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>shade</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.21.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-project-info-reports-plugin</artifactId>
                    <version>3.7.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
          Bench: builds target-bench/microbenchmarks.jar from the shakers benchmarks + HistoProfiler.
            mvn -Pbench package
            java -jar target-bench/microbenchmarks.jar
          The benchmarks live in src/test/java, so this profile adds them as main sources, compiles only these into its own
          folder (target-bench) and skips tests. The normal build in target is not touched.
        -->
        <profile>
            <id>bench</id>
            <properties>
                <maven.test.skip>true</maven.test.skip>
            </properties>
            <build>
                <directory>${project.basedir}/target-bench</directory>
                <plugins>
                    <!-- A profile cannot change sourceDirectory, so src/test/java is added as a main source root -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>bench-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>conf/session/shakers/*Benchmark.java</include>
                                <include>prof/HistoProfiler.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <exclude>org.openjdk.jol:jol-core</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          Slides: converts the AsciiDoc slides in assets/presentation-40min (or -Dslides.dir) to HTML with AsciidoctorJ
          and to one PDF with Playwright for Java (no Ruby, no Node.js).
            mvn -Pslides process-resources
          Any other slide folder (same file naming) with -Dslides.dir, relative to the project root.
          Output in assets/presentation (-Dslides.out), emptied first; only this, nothing else is written there:
            <series>_<deck>_<slide>.html, index.html, 00_Index_NN.html  one page per slide, no JavaScript, Previous / Index / Next links
            Who-Moved-My-Heap.pdf (-Dslides.pdf.name)    the whole talk in one PDF to hand out
          Work files in target/slides (generate-resources stops here): plain/ (every converted page) and slides/ (the
          reveal.js decks, with reveal.js from its WebJar). SlidePublish.java copies the slide pages from
          plain/; SlidesToPdf.java prints the reveal.js decks and joins them into the PDF.
          The PDF uses Google Chrome if installed (or the CHROME environment variable); otherwise Playwright
          downloads its own Chromium once.
          Java runs SlideNav.java (copies the sources to target/slides/src and writes links, numbers and deck files there; the sources are never changed) and SlideImages.java (title and diagram images) first.
          Diagram blocks ([plantuml], [mermaid], ...; e.g. the QR code on index.adoc) are drawn by a Kroki
          server through asciidoctorj-diagram, so the build needs network access to it. Default https://kroki.io;
          a local one (docker run -p 8000:8000 yuzutech/kroki) with -Dkroki.url=http://localhost:8000
        -->
        <profile>
            <id>slides</id>
            <properties>
                <!-- The slide sources, relative to the project root: -Dslides.dir=<folder> builds another one -->
                <slides.dir>assets/presentation-40min</slides.dir>
                <slides.src>${project.basedir}/${slides.dir}</slides.src>
                <slides.tools>${project.basedir}/src/main/java/tools/presentation</slides.tools>
                <!-- The published slides: emptied and rewritten by every build -->
                <slides.out>${project.basedir}/assets/presentation</slides.out>
                <slides.pdf.name>Who-Moved-My-Heap.pdf</slides.pdf.name>
                <!-- Work files (converted pages and reveal.js decks), not published -->
                <slides.work>${project.build.directory}/slides</slides.work>
                <kroki.url>https://kroki.io</kroki.url>
            </properties>
            <build>
                <plugins>
                    <!-- 0. Fresh work files, so pages of renamed or removed slides are never published -->
                    <plugin>
                        <artifactId>maven-clean-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>slides-work</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${slides.work}</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 1. Navigation links, deck files and images -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>slide-navigation</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>${slides.tools}/SlideNav.java</argument>
                                        <argument>${project.basedir}</argument>
                                        <argument>${slides.src}</argument>
                                        <argument>${slides.work}/src</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>slide-images</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>${slides.tools}/SlideImages.java</argument>
                                        <argument>${project.basedir}</argument>
                                        <argument>${slides.src}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- 4. Publish: the slide pages into slides.out, after the HTML (generate-resources) is written -->
                            <execution>
                                <id>slide-publish</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>${slides.tools}/SlidePublish.java</argument>
                                        <argument>${slides.work}/plain</argument>
                                        <argument>${slides.out}</argument>
                                        <argument>${slides.work}/src</argument>
                                        <argument>${slides.src}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- 5. The talk PDF, from the reveal.js decks -->
                            <execution>
                                <id>slide-pdfs</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>${slides.tools}/SlidesToPdf.java</argument>
                                        <argument>${slides.work}/slides</argument>
                                        <argument>${slides.out}/${slides.pdf.name}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 2. reveal.js from its WebJar into target/slides/slides/reveal.js (for the PDF) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>revealjs</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>unpack</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>org.webjars.npm</groupId>
                                            <artifactId>reveal.js</artifactId>
                                            <version>${revealjs.version}</version>
                                            <outputDirectory>${slides.work}/slides/reveal.js</outputDirectory>
                                            <overWrite>true</overWrite>
                                            <includes>META-INF/resources/webjars/reveal.js/${revealjs.version}/**
                                            </includes>
                                            <fileMappers>
                                                <org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                                                    <pattern>
                                                        ^META-INF/resources/webjars/reveal.js/${revealjs.version}/
                                                    </pattern>
                                                    <replacement>./</replacement>
                                                </org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                                            </fileMappers>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 2b. The shared images (assets/images/*.svg and *.png) next to the work files, where the ../images links of the work pages
                         point (target/slides/{plain,slides}); the published pages use assets/images itself -->
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>slides-shared-images</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${slides.work}/images</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/assets/images</directory>
                                            <includes>
                                                <include>*.svg</include>
                                                <include>*.png</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 3. HTML work files: plain pages (html5) and reveal.js decks -->
                    <plugin>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctor-maven-plugin</artifactId>
                        <version>${asciidoctor-maven-plugin.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.asciidoctor</groupId>
                                <artifactId>asciidoctorj-revealjs</artifactId>
                                <version>${asciidoctorj-revealjs.version}</version>
                            </dependency>
                            <!-- Diagram blocks, rendered by the Kroki server below (no Ruby, Node.js or Graphviz needed) -->
                            <dependency>
                                <groupId>org.asciidoctor</groupId>
                                <artifactId>asciidoctorj-diagram</artifactId>
                                <version>${asciidoctorj-diagram.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <sourceDirectory>${slides.work}/src</sourceDirectory>
                            <requires>
                                <require>asciidoctor-diagram</require>
                            </requires>
                            <attributes>
                                <!-- The sources use :imagesdir: ../images (assets/images from the slide folder); the same value is set here so the pages are
                                     built in target/slides/{plain,slides} and published in assets/presentation, where the shared
                                     images are one level up (the copy step above puts them next to the work files too) -->
                                <imagesdir>../images</imagesdir>
                                <diagram-server-url>${kroki.url}</diagram-server-url>
                                <diagram-server-type>kroki_io</diagram-server-type>
                                <!-- Kroki runs the PlantUML preprocessor itself, so no local PlantUML: any value but "true" turns the
                                     local step off ("false" would unset the attribute and leave it on) -->
                                <plantuml-preprocess>off</plantuml-preprocess>
                            </attributes>
                        </configuration>
                        <executions>
                            <execution>
                                <id>slides-plain</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>process-asciidoc</goal>
                                </goals>
                                <configuration>
                                    <backend>html5</backend>
                                    <outputDirectory>${slides.work}/plain</outputDirectory>
                                </configuration>
                            </execution>
                            <execution>
                                <id>slides-revealjs</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>process-asciidoc</goal>
                                </goals>
                                <configuration>
                                    <backend>revealjs</backend>
                                    <outputDirectory>${slides.work}/slides</outputDirectory>
                                    <attributes>
                                        <revealjsdir>reveal.js</revealjsdir>
                                    </attributes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
